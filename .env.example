# FL-AgentPlatform Configuration
# Copy to .env and fill in values

# Database
FL_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fl_platform

# LLM Providers
FL_DEFAULT_LLM_PROVIDER=stub
FL_ANTHROPIC_API_KEY=
FL_OPENAI_API_KEY=

# FAL.AI
FL_FAL_API_KEY=

# App
FL_DEBUG=true
FL_HOST=0.0.0.0
FL_PORT=8000

# Artifacts storage
FL_ARTIFACTS_DIR=./artifacts
